<resources>
    <!-- Base Application Theme: M3 Expressive / Material 3 -->
    <style name="Theme.LightNotes" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_amber</item>
        <item name="colorOnPrimary">#1A1A1A</item>
        
        <item name="colorSurface">#F7F7F9</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceContainer">#FFFFFF</item>
        <item name="colorSurfaceContainerHigh">#FFFFFF</item>
        <item name="colorOutlineVariant">#E6E6EA</item>

        <item name="android:colorBackground">#F7F7F9</item>
        <item name="android:windowBackground">#F7F7F9</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorLink">@color/brand_amber</item>
        
        <!-- Outlined M3 CardView Style -->
        <item name="materialCardViewStyle">@style/Widget.LightNotes.CardView</item>
        
        <!-- M3 BottomSheetDialog Style -->
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.LightNotes.BottomSheetDialog</item>

        <!-- M3 PopupMenu Style -->
        <item name="popupMenuStyle">@style/Widget.LightNotes.PopupMenu</item>
    </style>

    <style name="Widget.LightNotes.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_m3_popup_surface</item>
    </style>

    <style name="ThemeOverlay.LightNotes.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.LightNotes.BottomSheet</item>
    </style>

    <style name="Widget.LightNotes.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.LightNotes.BottomSheet</item>
        <item name="backgroundTint">?attr/colorSurfaceContainer</item>
    </style>

    <style name="ShapeAppearance.LightNotes.BottomSheet" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.LightNotes.CardView" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="rippleColor">@color/brand_amber_ripple</item>
    </style>

    <style name="Widget.LightNotes.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="android:background">?attr/colorSurface</item>
    </style>

    <style name="Widget.LightNotes.FAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/brand_amber</item>
        <item name="tint">@color/fab_icon</item>
        <item name="elevation">2dp</item>
        <item name="borderWidth">0dp</item>
        <item name="fabCustomSize">52dp</item>
    </style>

    <style name="Widget.LightNotes.TabButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:minHeight">32dp</item>
        <item name="cornerRadius">6dp</item>
    </style>
</resources>
