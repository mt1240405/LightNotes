<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/editorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fitsSystemWindows="false">

    <!-- Top Action Bar: Single Material 3 Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/editorToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/bg_main"
        app:contentInsetStart="12dp"
        app:contentInsetEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Clean M3 TextButton for Toggle Mode (Preview vs Edit) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleMode"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minHeight="44dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="@string/preview_label"
                android:textColor="@color/brand_amber"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                app:icon="@drawable/ic_eye"
                app:iconTint="@color/brand_amber"
                app:iconSize="18dp"
                app:iconGravity="textStart"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                app:cornerRadius="8dp" />

            <!-- First-Class Share Button -->
            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Share Note"
                android:src="@drawable/ic_share"
                app:tint="@color/text_primary" />

            <!-- Overflow Menu (Pin, Favorite, Move to Folder, Archive, Delete) -->
            <ImageButton
                android:id="@+id/btnOverflowMenu"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="More Options"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/text_primary" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Collapsible Find in Note Bar -->
    <LinearLayout
        android:id="@+id/layoutSearchBar"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="@color/card_bg"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/editorToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search"
            app:tint="@color/text_hint" />

        <EditText
            android:id="@+id/etSearchQuery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Find in note..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvSearchMatches"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp"
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            tools:text="1/3" />

        <ImageButton
            android:id="@+id/btnSearchPrev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous match"
            android:src="@drawable/ic_undo"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnSearchNext"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next match"
            android:src="@drawable/ic_redo"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnCloseSearch"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close search"
            android:src="@drawable/ic_delete"
            app:tint="@color/text_hint" />
    </LinearLayout>

    <!-- Main Content Area constrained strictly between Top Bars and Bottom Formatting Toolbar -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/layoutSearchBar"
        app:layout_constraintBottom_toTopOf="@id/bottomToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Single-line metadata bar above Title: dd/MM/yyyy, h:mm a | 125 words | Folder Name with clickable pin -->
            <LinearLayout
                android:id="@+id/layoutMetadataRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvEditorDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:text="24/11/2026, 2:00 AM | 125 words | Personal" />

                <!-- The ONLY Pin icon in the editor -->
                <ImageView
                    android:id="@+id/ivInlinePin"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Pin Note"
                    android:src="@drawable/ic_pin_outline"
                    app:tint="@color/text_hint" />
            </LinearLayout>

            <!-- Title: 22sp bold, 16dp spacing from metadata and body -->
            <EditText
                android:id="@+id/etNoteTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:hint="@string/title_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Frame containing Editor EditText or Native Preview TextView -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="320dp">

                <EditText
                    android:id="@+id/etNoteContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="320dp"
                    android:background="@null"
                    android:gravity="top|start"
                    android:hint="@string/content_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:lineSpacingMultiplier="1.4"
                    android:scrollbars="none"
                    android:overScrollMode="never"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="16sp" />

                <!-- Native Preview Container: supports single TextView or alternating prose & native TableLayouts -->
                <LinearLayout
                    android:id="@+id/layoutPreviewContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Default Native Markwon Rendered TextView -->
                    <TextView
                        android:id="@+id/tvNoteRendered"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="320dp"
                        android:lineSpacingMultiplier="1.4"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Single Compact Formatting Toolbar: Horizontally scrollable, docked above IME -->
    <!-- Single Compact Formatting Toolbar Container: Docked above IME / Navigation -->
    <LinearLayout
        android:id="@+id/bottomToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_main"
        android:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Fixed Left: Undo & Redo (Always visible without horizontal scrolling) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="2dp">

            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:alpha="0.35"
                android:enabled="false"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Undo"
                android:src="@drawable/ic_undo"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/btnRedo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:alpha="0.35"
                android:enabled="false"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Redo"
                android:src="@drawable/ic_redo"
                app:tint="@color/text_primary" />

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@color/divider" />
        </LinearLayout>

        <!-- Horizontally scrollable formatting tools -->
        <HorizontalScrollView
            android:id="@+id/scrollFormattingTools"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="8dp">

                <ImageButton
                    android:id="@+id/btnFormatBold"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Bold"
                    android:src="@drawable/ic_format_bold"
                    app:tint="@color/text_primary" />

                <ImageButton
                    android:id="@+id/btnFormatItalic"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Italic"
                    android:src="@drawable/ic_format_italic"
                    app:tint="@color/text_primary" />

                <ImageButton
                    android:id="@+id/btnFormatHeading"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Heading"
                    android:src="@drawable/ic_format_heading"
                    app:tint="@color/text_primary" />

                <ImageButton
                    android:id="@+id/btnFormatBullet"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Bulleted List"
                    android:src="@drawable/ic_format_list"
                    app:tint="@color/text_primary" />

                <ImageButton
                    android:id="@+id/btnFormatNumber"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Numbered List"
                    android:src="@drawable/ic_format_numbered_list"
                    app:tint="@color/text_primary" />

                <ImageButton
                    android:id="@+id/btnFormatChecklist"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Checklist"
                    android:src="@drawable/ic_format_task"
                    app:tint="@color/text_primary" />

                <ImageButton
                    android:id="@+id/btnFormatImage"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Insert Image"
                    android:src="@drawable/ic_image"
                    app:tint="@color/text_primary" />

                <ImageButton
                    android:id="@+id/btnFormatLink"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Link"
                    android:src="@drawable/ic_link"
                    app:tint="@color/text_primary" />

                <ImageButton
                    android:id="@+id/btnFormatCode"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Code Block"
                    android:src="@drawable/ic_format_code"
                    app:tint="@color/text_primary" />

                <ImageButton
                    android:id="@+id/btnFormatQuote"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Blockquote"
                    android:src="@drawable/ic_format_quote"
                    app:tint="@color/text_primary" />

            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
