<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_bg"
    android:padding="16dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@color/divider" />

    <!-- Tab Selector -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_preview_toggle_inactive">

        <TextView
            android:id="@+id/tabToc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Outline (TOC)"
            android:textColor="@color/brand_amber"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="@drawable/bg_preview_toggle_active" />

        <TextView
            android:id="@+id/tabBacklinks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Backlinks (0)"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Outline View Container -->
    <LinearLayout
        android:id="@+id/layoutToc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvToc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="300dp" />

        <TextView
            android:id="@+id/tvTocEmpty"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center"
            android:text="No headings found in this note (#, ##, ###)"
            android:textColor="@color/text_hint"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Backlinks View Container -->
    <LinearLayout
        android:id="@+id/layoutBacklinks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBacklinks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="300dp" />

        <TextView
            android:id="@+id/tvBacklinksEmpty"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center"
            android:text="No incoming backlinks from other notes"
            android:textColor="@color/text_hint"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
