<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Drag Handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_preview_toggle_inactive" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="PDF Export Studio"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="LaTeX-grade academic typesetting &amp; advanced CSS print styling"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Flat Segmented Tab Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_preview_toggle_inactive"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btnTabTypesetting"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_preview_toggle_active"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Layout &amp; Typesetting"
                android:textColor="@color/brand_amber"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnTabAdvancedCss"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Advanced CSS Styling"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ========================================== -->
        <!-- TAB 1: LAYOUT & TYPESETTING                -->
        <!-- ========================================== -->
        <LinearLayout
            android:id="@+id/layoutTabTypesetting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Typesetting Presets -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Typesetting Preset"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgPresets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbPresetLatex"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="LaTeX Academic (article, serif, justified, 22mm)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbPresetModern"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Clean Modern (ColorOS sans, 16mm, left-aligned)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbPresetCompact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Technical Spec (Compact, mono, 12mm, dense)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </RadioGroup>

            <!-- 2. Paper Theme -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Paper Theme"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgPaperTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbThemeLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Clean Light"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbThemeSepia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Warm Sepia"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbThemeDark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Dark OLED (#000000)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </RadioGroup>

            <!-- 3. Page Geometry -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Page Size"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgPageSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbSizeA4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="A4"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbSizeLetter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Letter"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbSizeLegal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Legal"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbSizeA5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="A5"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbSizeCustom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Custom"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </RadioGroup>

            <!-- Custom Page Dimensions row (gone by default) -->
            <LinearLayout
                android:id="@+id/layoutCustomDimensions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etCustomWidth"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_preview_toggle_inactive"
                    android:hint="Width (mm, e.g. 210)"
                    android:inputType="numberDecimal"
                    android:padding="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etCustomHeight"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_preview_toggle_inactive"
                    android:hint="Height (mm, e.g. 297)"
                    android:inputType="numberDecimal"
                    android:padding="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Margins Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Page Margins"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgMargins"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbMargin12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12mm"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbMargin16"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="16mm"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbMargin22"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:checked="true"
                    android:text="22mm (LaTeX)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbMarginCustom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Custom"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </RadioGroup>

            <!-- Detailed Custom Margins (gone by default) -->
            <LinearLayout
                android:id="@+id/layoutCustomMargins"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etMarginTop"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_preview_toggle_inactive"
                    android:hint="Top mm"
                    android:inputType="numberDecimal"
                    android:padding="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etMarginRight"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_preview_toggle_inactive"
                    android:hint="Right mm"
                    android:inputType="numberDecimal"
                    android:padding="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etMarginBottom"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_preview_toggle_inactive"
                    android:hint="Bottom mm"
                    android:inputType="numberDecimal"
                    android:padding="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etMarginLeft"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_preview_toggle_inactive"
                    android:hint="Left mm"
                    android:inputType="numberDecimal"
                    android:padding="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 4. Typography & Layout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <!-- Font Family -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Font Family"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgFontFamily"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">

                        <RadioButton
                            android:id="@+id/rbFontSerif"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="LaTeX Serif"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rbFontSans"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Modern Sans"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rbFontMono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Technical Mono"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </RadioGroup>
                </LinearLayout>

                <!-- Font Size -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Font Size"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgFontSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">

                        <RadioButton
                            android:id="@+id/rbSize10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10 pt"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rbSize11"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="11 pt (LaTeX)"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rbSize12"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12 pt"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rbSize14"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="14 pt"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rbSize16"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="16 pt"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>

            <!-- Line Height & Text Alignment -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Line Height"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgLineHeight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">

                        <RadioButton
                            android:id="@+id/rbLine115"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.15"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rbLine135"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.35 (Compact)"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rbLine155"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="1.60 (LaTeX)"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rbLine18"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.80 (Spacious)"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </RadioGroup>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Text Alignment"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgTextAlignment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">

                        <RadioButton
                            android:id="@+id/rbAlignJustified"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Justified (LaTeX)"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rbAlignLeft"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Left-aligned"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>

            <!-- Toggles for Header and Page Numbers -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchShowHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Include Title &amp; Timestamp Header"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchShowPageNumbers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:checked="true"
                    android:text="Page Numbers Footer (@bottom-right)"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- ========================================== -->
        <!-- TAB 2: ADVANCED CSS STYLING MENU           -->
        <!-- ========================================== -->
        <LinearLayout
            android:id="@+id/layoutTabAdvancedCss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="One-Tap CSS Style Snippets"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tap snippet to append or toggle in stylesheet"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <!-- Snippets horizontal chip scroll -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnSnippetTwoColumn"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_preview_toggle_inactive"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Two-Column Layout"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnSnippetNumberedHeadings"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_preview_toggle_inactive"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Numbered H1"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnSnippetIeeeTables"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_preview_toggle_inactive"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="IEEE Tables"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnSnippetDraftWatermark"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_preview_toggle_inactive"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Draft Watermark"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnSnippetPageBreakH1"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_preview_toggle_inactive"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Page Break H1"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Editor header row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Live Stylesheet (Custom CSS)"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnResetCss"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_preview_toggle_inactive"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Reset CSS"
                    android:textColor="@color/color_trash_red"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Monospace CSS editor -->
            <EditText
                android:id="@+id/etCustomCss"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="140dp"
                android:background="@drawable/bg_preview_toggle_inactive"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:hint="/* Custom print CSS rules injected into &lt;style&gt; */\nbody {\n    /* Custom styling */\n}"
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSaveCssDefault"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/search_fill"
                android:fontFamily="sans-serif-medium"
                android:text="Save Stylesheet as Default"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- ========================================== -->
        <!-- ACTION BUTTON (SHARED ACROSS TABS)         -->
        <!-- ========================================== -->
        <Button
            android:id="@+id/btnGeneratePdf"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="@color/brand_amber"
            android:fontFamily="sans-serif-medium"
            android:text="Generate &amp; Print PDF"
            android:textColor="@color/fab_icon"
            android:textSize="14sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
