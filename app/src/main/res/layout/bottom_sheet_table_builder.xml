<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_bg"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_preview_toggle_inactive" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="GFM Table Builder"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Select dimensions and column alignment"
        android:textColor="@color/text_hint"
        android:textSize="12sp" />

    <!-- Rows and Columns Steppers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <!-- Rows -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rows"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDecRows"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_preview_toggle_inactive"
                    android:text="-"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    style="@style/Widget.MaterialComponents.Button.TextButton" />

                <TextView
                    android:id="@+id/tvRowCount"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnIncRows"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_preview_toggle_inactive"
                    android:text="+"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    style="@style/Widget.MaterialComponents.Button.TextButton" />
            </LinearLayout>
        </LinearLayout>

        <!-- Columns -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Columns"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDecCols"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_preview_toggle_inactive"
                    android:text="-"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    style="@style/Widget.MaterialComponents.Button.TextButton" />

                <TextView
                    android:id="@+id/tvColCount"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnIncCols"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_preview_toggle_inactive"
                    android:text="+"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    style="@style/Widget.MaterialComponents.Button.TextButton" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Alignment Options -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Column Alignment"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/rgAlignment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbAlignLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Left"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbAlignCenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Center"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbAlignRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Right"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </RadioGroup>

    <!-- Insert Button -->
    <Button
        android:id="@+id/btnInsertTable"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/brand_amber"
        android:fontFamily="sans-serif-medium"
        android:text="Insert Table"
        android:textColor="@color/fab_icon"
        android:textSize="14sp" />

</LinearLayout>
