<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_bg"
    android:padding="20dp">

    <!-- Top Handle Bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_preview_toggle_inactive" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_ai_sparkle" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/ai_assistant"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseAi"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            app:tint="@color/text_hint" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTargetScope"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Operating on full note content"
        android:textColor="@color/text_hint"
        android:textSize="12sp" />

    <!-- Quick Action Chips Container -->
    <HorizontalScrollView
        android:id="@+id/scrollActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnActionGrammar"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_preview_toggle_inactive"
                android:fontFamily="sans-serif-medium"
                android:text="@string/ai_grammar"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <Button
                android:id="@+id/btnActionSummarize"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_preview_toggle_inactive"
                android:fontFamily="sans-serif-medium"
                android:text="@string/ai_summarize"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <Button
                android:id="@+id/btnActionContinue"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_preview_toggle_inactive"
                android:fontFamily="sans-serif-medium"
                android:text="@string/ai_continue"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <Button
                android:id="@+id/btnActionConcise"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_preview_toggle_inactive"
                android:fontFamily="sans-serif-medium"
                android:text="@string/ai_concise"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <Button
                android:id="@+id/btnActionChecklist"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_preview_toggle_inactive"
                android:fontFamily="sans-serif-medium"
                android:text="@string/ai_checklist"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <Button
                android:id="@+id/btnActionMarkdown"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_preview_toggle_inactive"
                android:fontFamily="sans-serif-medium"
                android:text="@string/ai_markdown"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <Button
                android:id="@+id/btnActionCustom"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_preview_toggle_inactive"
                android:fontFamily="sans-serif-medium"
                android:text="@string/ai_custom"
                android:textColor="@color/brand_amber"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Custom Prompt Input Field -->
    <LinearLayout
        android:id="@+id/layoutCustomPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/etCustomPrompt"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_preview_toggle_inactive"
            android:hint="Enter prompt instructions…"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSubmitCustomPrompt"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/brand_amber"
            android:text="Run"
            android:textColor="@color/fab_icon"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Loading Indicator -->
    <LinearLayout
        android:id="@+id/layoutAiLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminateTint="@color/brand_amber" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ai_generating"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Result Container -->
    <LinearLayout
        android:id="@+id/layoutAiResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="AI Output:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxHeight="200dp"
            android:background="@drawable/bg_preview_toggle_inactive"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvAiOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.4"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                tools:text="Here is the AI generated response with suggestions." />
        </androidx.core.widget.NestedScrollView>

        <!-- Actions: Replace, Insert Below, Copy -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAiCopy"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_preview_toggle_inactive"
                android:text="@string/ai_copy"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <Button
                android:id="@+id/btnAiInsertBelow"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_preview_toggle_inactive"
                android:text="@string/ai_insert_below"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <Button
                android:id="@+id/btnAiReplace"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/brand_amber"
                android:text="@string/ai_replace"
                android:textColor="@color/fab_icon"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
